      "type": "object"
    },
    "toolchain_evidence": {
      "additionalProperties": false,
      "properties": {
        "compiler_exact_version_repository_hash_bound": {
          "const": false
        },
        "complete_parent_environment_published": {
          "const": false
        },
        "go_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "go_mod_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "go_mod_sum_unchanged_after_build": {
          "const": true
        },
        "go_sum_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "go_toolchain_policy": {
          "const": "local"
