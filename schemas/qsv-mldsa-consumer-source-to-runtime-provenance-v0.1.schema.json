        },
        "runtime_executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "runtime_executable_sha256"
      ],
      "type": "object"
    },
    "runtime_identity": {
      "additionalProperties": false,
