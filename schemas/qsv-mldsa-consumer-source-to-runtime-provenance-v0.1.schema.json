{
  "$defs": {
    "consumer": {
      "additionalProperties": false,
      "properties": {
        "consumer_authority": {
          "$ref": "#/$defs/path_hash"
        },
        "historical_build_event": {
          "$ref": "#/$defs/historical_build_event"
        },
        "implementation_id": {
          "enum": [
            "openssl",
            "cloudflare-circl"
          ]
        },
        "normalized_result_bindings": {
          "items": {
            "$ref": "#/$defs/normalized_binding"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "runtime_identity": {
          "$ref": "#/$defs/runtime_identity"
        },
        "source_identity": {
          "$ref": "#/$defs/source_identity"
        },
        "source_to_runtime_provenance": {
          "$ref": "#/$defs/source_to_runtime_provenance"
        }
      },
      "required": [
        "implementation_id",
        "consumer_authority",
        "source_identity",
        "historical_build_event",
        "runtime_identity",
        "normalized_result_bindings",
        "source_to_runtime_provenance"
      ],
      "type": "object"
    },
    "git_oid": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "historical_build_event": {
      "additionalProperties": false,
      "properties": {
        "build_recipe_identity": {
          "enum": [
            "OPENSSL_CONFIGURE_LINUX_X86_64_NO_SHARED_MAKE_J2_INSTALL_SW_CC_STATIC_LIBCRYPTO",
            "CIRCL_EXACT_SOURCE_GO_BUILD_MOD_READONLY_TRIMPATH_GOTOOLCHAIN_LOCAL"
          ]
        },
        "github_job_id": {
          "const": 104377847614
        },
        "github_run_attempt": {
          "const": 1
        },
        "github_run_id": {
          "const": 34968252038
        },
        "model": {
          "const": "FIRST_PARTY_HISTORICAL_GITHUB_ACTIONS_BUILD_EVENT"
        },
        "produced_artifacts": {
          "$ref": "#/$defs/produced_artifacts"
        },
        "source_checkout_exact": {
          "const": true
        },
        "toolchain_evidence": {
          "$ref": "#/$defs/toolchain_evidence"
        },
        "workflow": {
          "$ref": "#/$defs/path_hash"
        }
      },
      "required": [
        "model",
        "github_run_id",
        "github_job_id",
        "github_run_attempt",
        "workflow",
        "source_checkout_exact",
        "build_recipe_identity",
        "toolchain_evidence",
        "produced_artifacts"
      ],
      "type": "object"
    },
    "normalized_binding": {
      "additionalProperties": false,
      "properties": {
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_id": {
          "type": "string"
        },
        "source_bound_case_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "case_id",
        "canonical_sha256",
        "source_bound_case_sha256"
      ],
      "type": "object"
    },
    "path_hash": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "predecessor": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/git_oid"
        },
        "parent": {
          "$ref": "#/$defs/git_oid"
        },
        "repository": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "tree": {
          "$ref": "#/$defs/git_oid"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "parent",
        "subject"
      ],
      "type": "object"
    },
    "produced_artifacts": {
      "additionalProperties": false,
      "properties": {
        "openssl_built_binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "openssl_built_libcrypto_sha256": {
