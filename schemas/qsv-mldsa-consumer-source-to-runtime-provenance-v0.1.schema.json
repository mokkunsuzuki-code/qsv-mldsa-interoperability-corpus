          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        },
        "runtime_evidence": {
          "$ref": "#/$defs/path_hash"
        }
      },
      "required": [
        "runtime_evidence",
        "executable_sha256",
        "historical_invocation_count",
        "invocation_ids"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_identity": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/git_oid"
        },
        "repository": {
          "type": "string"
        },
        "tree": {
          "$ref": "#/$defs/git_oid"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "version"
      ],
      "type": "object"
    },
    "source_to_runtime_provenance": {
      "additionalProperties": false,
      "properties": {
        "complete_environment_provenance": {
          "const": false
        },
        "historical_and_prospective_runtime_identity_separate": {
          "const": true
        },
        "independent_rebuild_proven": {
          "const": false
        },
        "level": {
          "const": "LEVEL_3_BUILD_EVENT_EVIDENCED"
        },
        "predecessor_consumer_status": {
          "const": "incomplete"
        },
        "reproducible_build_proven": {
          "const": false
        },
        "scope": {
          "const": "SELECTED_SIX_CASE_F7_HISTORICAL_EXECUTION"
        },
        "status": {
          "const": "HISTORICAL_BUILD_EVENT_EVIDENCED"
        }
      },
      "required": [
        "level",
        "status",
        "scope",
        "predecessor_consumer_status",
        "historical_and_prospective_runtime_identity_separate",
        "reproducible_build_proven",
        "independent_rebuild_proven",
        "complete_environment_provenance"
