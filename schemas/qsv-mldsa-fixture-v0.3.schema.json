{
  "$id": "urn:qsv:mldsa:fixture:0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QSV ML-DSA neutral fixture v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "fixture_id",
    "dimension",
    "parameter_set",
    "operation",
    "producer",
    "consumer",
    "message",
    "context",
    "randomness_mode",
    "expected_outcome",
    "artifacts",
    "provenance",
    "publication_classification",
    "source_binding",
    "neutral_fixture_sha256"
  ],
  "properties": {
    "schema": {
      "const": "qsv.mldsa.fixture.v0.3"
    },
    "algorithm": {
      "const": "ML-DSA"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "enum": [
        "known_answer_conformance",
        "cross_implementation_interoperability",
        "negative_behavior"
      ]
    },
    "parameter_set": {
      "enum": [
        "ML-DSA-44",
        "ML-DSA-65",
        "ML-DSA-87"
      ]
    },
    "operation": {
      "enum": [
        "key_generation",
        "sign",
        "verify"
      ]
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "consumer": {
      "type": [
        "object",
        "null"
      ]
    },
    "message": {
      "$ref": "#/$defs/artifact_reference"
    },
    "context": {
      "$ref": "#/$defs/artifact_reference"
    },
    "randomness_mode": {
      "enum": [
        "deterministic",
        "hedged_or_randomized",
        "not_applicable"
      ]
    },
    "expected_outcome": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_test_key",
        "public_key",
        "signature"
      ],
      "properties": {
        "private_test_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_specific",
        "generation"
      ],
      "properties": {
        "source_specific": {
          "type": "object"
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "mode",
            "new_crypto_execution"
          ],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "new_crypto_execution": {
              "const": false
            }
          }
        }
      }
    },
    "publication_classification": {
      "enum": [
        "public_non_secret_metadata_only",
        "public_test_only_material",
        "not_authorized_for_publication"
      ]
    },
    "source_binding": {
      "$ref": "#/$defs/source_binding"
    },
    "neutral_fixture_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "value",
        "external_reference",
        "sha256",
        "byte_count"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "hex",
            "binary",
            "utf-8"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "not": {
        "type": "object",
        "required": [
          "value",
          "external_reference"
        ],
        "properties": {
          "value": {
            "type": "null"
          },
          "external_reference": {
            "type": "null"
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "repository",
        "commit",
        "tree",
        "tree_status"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "tree_status": {
          "enum": [
            "recorded",
            "not_recorded_historical"
          ]
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "coordinates"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "contract_sha256",
        "case_source_hash_profile",
        "neutral_fixture_hash_profile"
      ],
      "properties": {
        "contract_path": {
          "type": "string",
          "minLength": 1
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_source_hash_profile": {
          "const": "QSV-MLDSA-SOURCE-CASE-V1"
        },
        "neutral_fixture_hash_profile": {
          "const": "QSV-MLDSA-NEUTRAL-FIXTURE-V1"
        }
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_family",
        "source_repository",
        "source_commit",
        "source_tree",
        "source_tree_status",
        "source_files",
        "case_identity",
        "case_source_sha256",
        "canonicalization"
      ],
      "properties": {
        "source_family": {
          "enum": [
            "nist_acvp",
            "wycheproof",
            "qsv_regression"
          ]
        },
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "minLength": 1
        },
        "source_tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_tree_status": {
          "enum": [
            "recorded",
            "not_recorded_historical"
          ]
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_file"
          }
        },
        "case_identity": {
          "$ref": "#/$defs/case_identity"
        },
        "case_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalization": {
          "$ref": "#/$defs/canonicalization"
        }
      }
    }
  }
}
